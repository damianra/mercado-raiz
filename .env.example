# Variables de entorno de la app — copiar a `.env` (gitignored) y
# completar. Todo lo declarado acá es lo que el código puede leer via
# process.env.NOMBRE — los secretos nunca van hardcodeados ni
# commiteados.

# Puerto de la API (default 4000)
# PORT=4000

# API keys de servicios externos (declarar las que la app necesite):
# MI_API_KEY=
# STRIPE_SECRET_KEY=

# SPEC-23 — secreto para firmar JWT (access tokens). Obligatorio en
# producción; en dev hay un fallback inseguro solo para tests.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Rate limit propio de POST /api/auth/login (intentos/min por IP).
AUTH_RATE_LIMIT=10

# Rate limit global de escrituras /api (mutaciones/min por IP).
# Default 20 — CI/e2e lo sube porque todos los tests comparten IP.
API_RATE_LIMIT=20

# SPEC-25 — conexión Postgres. Runtime: DATABASE_URL; tests:
# DATABASE_URL_TEST (vitest la usa para mercadoraiz-db-test).
# Sin setear, db.js usa los defaults del compose dev — solo declarar
# para apuntar a otro Postgres (staging/prod).
# Defaults dev: postgres://mercadoraiz:dev-local-2026@localhost:5432/{mercadoraiz-db,mercadoraiz-db-test}
# DATABASE_URL=
# DATABASE_URL_TEST=

digraph negocio {
  rankdir=TB;
  bgcolor="white";
  pad=0.3;
  nodesep=0.45;
  ranksep=0.5;
  compound=true;

  node [fontname="Helvetica", fontsize=11, style="rounded,filled",
        color="#44403c", fillcolor="#ffffff", penwidth=1.3, margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=9, color="#57534e",
        arrowsize=0.8, penwidth=1.1];

  labelloc="t";
  label="REPOSICIÓN DE INVENTARIO — la regla de negocio en una corrida\n(el agente hace el trabajo; el orquestador lo gobierna; la persona decide lo caro)";
  fontsize=14;
  fontname="Helvetica-Bold";

  subgraph cluster_proceso {
    label="EL PROCESO — qué se hace, paso a paso";
    labelloc="t";
    fontsize=12;
    fontname="Helvetica-Bold";
    style="rounded,filled";
    fillcolor="#f5f5f4";
    color="#d6d3d1";

    p1 [label="1 · DETECTAR FALTANTES\n¿qué productos quedaron bajo el\nstock mínimo o en estado crítico?\n→ lista de lo que hay que reponer"];

    p2 [label="2 · ESTIMAR LA DEMANDA\n¿cuánto se va a vender por día?\nla IA lee las ventas y busca patrones\n(fines de semana, rachas, picos)\n· si las ventas son estables, basta\nel promedio — regla: la IA solo\ndonde aporta criterio",
        fillcolor="#a7f3d0"];

    p3 [label="3 · CALCULAR EL PEDIDO\ncomprar lo que cubra la demanda\nmientras tarda el proveedor\n+ 7 días de margen\n· piso: el doble del stock mínimo"];

    p4 [label="4 · POLÍTICA DE APROBACIÓN\n¿el pedido supera los $100?\nregla de negocio: los montos\ngrandes los revisa una persona"];

    p5 [label="5 · JUSTIFICAR LA COMPRA\nsolo si la revisa un humano:\nla IA redacta el porqué del pedido\ncon los números ya decididos\n(es lo que lee el aprobador)",
        fillcolor="#a7f3d0"];

    p6 [label="6 · EMITIR LAS ÓRDENES\nse registran en el sistema:\nlas chicas quedan aprobadas,\nlas grandes quedan pendientes"];

    p7 [label="7 · AVISAR Y CERRAR\nsi hubo pendientes se avisa al\naprobador · se deja un resumen\nde la corrida con los KPIs"];

    p1 -> p2 -> p3 -> p4 -> p5 -> p6 -> p7;
  }

  humano [shape=box, fillcolor="#fde68a",
          label="LA PERSONA APROBADORA\nrevisa los pedidos ≥ $100 desde el\ntablero, cuando quiera: aprueba o\nrechaza. La decisión queda en el\nsistema — nada vuelve al agente"];
  p6 -> humano [style=dashed, label=" pendientes\n≥ $100"];

  subgraph cluster_orq {
    label="EL ORQUESTADOR — el supervisor del proceso\n(no sabe de inventario: sabe de ejecutar bien)";
    labelloc="t";
    fontsize=12;
    fontname="Helvetica-Bold";
    style="rounded,filled";
    fillcolor="#e7e5e4";
    color="#a8a29e";

    o1 [shape=box, fillcolor="#ffffff", fontsize=10,
        label="DISPARA la corrida\n(arranque o a pedido)"];
    o2 [shape=box, fillcolor="#ffffff", fontsize=10,
        label="VIGILA cada paso en vivo\n— se ve al agente\n'moverse'"];
    o3 [shape=box, fillcolor="#ffffff", fontsize=10,
        label="REINTENTA ante fallas\ntransitorias — ninguna\nseñal se pierde"];
    o4 [shape=box, fillcolor="#ffffff", fontsize=10,
        label="MIDE tiempo y costo\nde la IA por corrida"];
    o5 [shape=box, fillcolor="#ffffff", fontsize=10,
        label="TRAZA cada paso — la\ncorrida queda auditable"];
    o6 [shape=box, fillcolor="#ffffff", fontsize=10,
        label="INFORMA: estado y métricas\nde la corrida quedan\nconsultables"];

    o1 -> o2 -> o3 -> o4 -> o5 -> o6 [style=invis];
  }

  o1 -> p1 [ltail=cluster_orq, lhead=cluster_proceso, style=dashed,
            arrowhead=none, label=" ejecuta y\n observa", constraint=false];

  subgraph cluster_leyenda {
    label=""; style="invis";
    l_ia [shape=box, fillcolor="#a7f3d0", fontsize=9, margin="0.08,0.04",
          label="paso donde la IA aporta criterio"];
    l_cod [shape=box, fillcolor="#ffffff", fontsize=9, margin="0.08,0.04",
           label="paso determinista (regla fija)"];
    l_per [shape=box, fillcolor="#fde68a", fontsize=9, margin="0.08,0.04",
           label="decisión humana"];
    l_ia -> l_cod -> l_per [style=invis];
  }
}

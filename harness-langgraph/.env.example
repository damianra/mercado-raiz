# Config del agente — copiar a `.env` (gitignored). Nada de esto es
# secreto real en la demo, pero la convención es la misma que en el
# backend: config fuera del código.

# Backend MVC al que el agente llama por HTTP
BACKEND_URL=http://localhost:4000

# Servidor Ollama local y modelo a usar
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Puerto del servidor HTTP del harness (GET /status, /metrics,
# POST /run; /resume queda para compat con corridas pausadas viejas)
HARNESS_PORT=4110

# Monto a partir del cual una orden de compra requiere aprobación
# humana (espejo de UMBRAL_APROBACION del backend — mantener igual)
UMBRAL_APROBACION=100

# Triage heurístico (SPEC-12): coeficiente de variación de ventas
# diarias por debajo del cual se estima demanda por promedio
# histórico sin llamar al LLM (0 = desactiva el triage)
UMBRAL_CV=0.3
